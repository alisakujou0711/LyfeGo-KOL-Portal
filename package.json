{
  "name": "lyfego-kol-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "python -m uvicorn app.main:app --reload --reload-dir backend --port 8000 --app-dir backend",
    "db:reset": "python backend/reset_db.py",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:web && npm run test:api",
    "test:web": "vitest run",
    "test:api": "python -m pytest backend"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
