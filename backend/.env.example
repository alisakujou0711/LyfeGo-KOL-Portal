# Copy to backend/.env (git-ignored) and fill in your local MySQL details.
# Tests use the same server and credentials, with a separate `lyfego_test` database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lyfego

# The demo Admin that `npm run db:reset` creates, for signing in at /admin/login.
# Add more Admins with: npm run admin -- add someone@lyfego.com "Their Name"
ADMIN_EMAIL=admin@lyfego.local
ADMIN_PASSWORD=lyfego-demo-admin
